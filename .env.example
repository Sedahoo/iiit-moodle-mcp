# Copy to .env and fill in. .env is gitignored.

# CAS login (login.iiit.ac.in)
IIIT_USERNAME=firstname.lastname@students.iiit.ac.in
IIIT_PASSWORD=your-cas-password

# Alternatives to a CAS login (use one instead of the two above)
# MOODLE_TOKEN=
# MOODLE_SESSION=

# Optional overrides (defaults shown)
# MOODLE_DOWNLOAD_DIR=~/Downloads/moodle
# MOODLE_TOKEN_CACHE=~/.cache/iiit-moodle-mcp/token.json
# MOODLE_BASE_URL=https://courses.iiit.ac.in
